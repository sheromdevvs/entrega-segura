{
  "name": "entrega-segura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3025",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3025}",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:ai": "tsx --env-file=.env scripts/evaluate-ai.ts",
    "sandbox:probe": "tsx --env-file=.env scripts/sandbox-probe.ts",
    "webhook:register": "tsx --env-file=.env scripts/register-webhook.ts",
    "test:sandbox": "RUN_SANDBOX_TESTS=1 node --env-file=.env node_modules/vitest/vitest.mjs run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fast-check": "^4.0.0",
    "prettier": "^3.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "type": "module"
}
